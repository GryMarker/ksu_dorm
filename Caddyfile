{
	frankenphp
}

:80 {
	root * /app/public

	# Serve static files directly with caching headers
	@static {
		file
		path /build/* /images/* /favicon.ico /robots.txt
	}
	header @static Cache-Control "public, max-age=31536000, immutable"
	file_server @static

	# Route all other requests through FrankenPHP (Laravel)
	php_server
}
